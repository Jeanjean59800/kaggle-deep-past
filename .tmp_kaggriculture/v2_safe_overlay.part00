
# ============================================================================
# Kaggriculture E300 V2 — route-compatible closed-loop overlay (engine 1.32.7)
# ============================================================================
# The proven low/high route remains physically intact.  This controller only
# changes market decisions, exact seed timing, emergency feed/hire recovery,
# bounded crop substitution on compatible late wheat slots, and endgame actions
# at the last safe moment.  It deliberately avoids general worker replanning:
# experiments showed that moving a worker off the recorded route destroys the
# downstream schedule.

from collections import Counter, deque

__version__ = "E300-V2-route-compatible-1.32.7"

_V2_PARENT_AGENT = _E279_PUBLIC_AGENT
_V2_ROUTE_ACTIONS = {"low": _E279_LOW_ACTIONS, "high": _E279_HIGH_ACTIONS}
_V2_HINGE_GAIN = 8.0
_V2_SEED_HORIZON = 48
_V2_END_STEP = 718
_V2_SELLABLE = (
    "WHEAT", "CARROT", "TOMATO", "STRAWBERRY", "MELON",
    "EGG", "MILK", "WOOL", "FERTILIZER",
)
_V2_CROP_DATA = {
    "WHEAT":      {"seed": 10,  "first": 2,  "max_day": 4,  "max_yield": 6, "latest": 27},
    "CARROT":     {"seed": 20,  "first": 2,  "max_day": 3,  "max_yield": 4, "latest": 26},
    "TOMATO":     {"seed": 50,  "first": 8,  "max_day": 8,  "max_yield": 4, "latest": 20},
    "STRAWBERRY": {"seed": 100, "first": 10, "max_day": 10, "max_yield": 4, "latest": 18},
    "MELON":      {"seed": 80,  "first": 10, "max_day": 12, "max_yield": 6, "latest": 17},
}
_V2_ANIMAL_DATA = {
    "GOOSE": {"cost": 300, "structure": "COOP", "product": "EGG"},
    "COW":   {"cost": 400, "structure": "PASTURE", "product": "MILK"},
    "SHEEP": {"cost": 500, "structure": "PASTURE", "product": "WOOL"},
}
_V2_SHOPS = {
    "BAKERY": ("EGG", "WHEAT"),
    "PIZZA_SHOP": ("MILK", "TOMATO", "WHEAT"),
    "BRUNCH_SPOT": ("EGG", "WHEAT", "STRAWBERRY"),
    "YARN_STORE": ("WOOL",),
    "ICE_CREAM_SHOP": ("STRAWBERRY", "MILK", "WHEAT"),
    "PET_CAFE": ("CARROT",),
    "SMOOTHIE_SHOP": ("STRAWBERRY", "MILK"),
    "FARMERS_MARKET": ("WHEAT", "CARROT", "TOMATO", "STRAWBERRY"),
}

# Variant switches.  The benchmark changes these constants before freezing one
# profile; the delivered file contains the selected values.
_V2_ROUTE_MODE = "original"          # original | repeated_yarn
_V2_JIT_SEEDS = True
_V2_CASH_PRIORITY = True
_V2_FLOOR_DEFERRAL = False
_V2_CARROT_SIDECAR = False
_V2_TERMINAL_RESCUE = True
_V2_LOCAL_ANIMAL_RESCUE = True
_V2_FEED_RESCUE = True

# Current official 1.32.7 market curves.  This overrides the stale price model
# used by the inherited ordering logic, notably hinge scarcity for carrot,
# tomato and egg.
_MARKET_PARAMS = {
    "WHEAT":      (25, 10000, 400, "sqrt",   0.80, "log",    0.20),
    "CARROT":     (35, 10000, 450, "hinge",  1.00, "sqrt",   0.70),
    "TOMATO":     (60, 10000, 200, "hinge",  0.40, "sqrt",   0.60),
    "STRAWBERRY": (120,10000, 100, "sqrt",   0.70, "linear", 1.60),
    "MELON":      (250,10000, 300, "log",    0.20, "sq",     3.60),
    "EGG":        (50, 10000, 332, "hinge",  0.40, "log",    0.20),
    "MILK":       (160,10000, 122, "sqrt",   0.60, "linear", 1.60),
    "WOOL":       (200,10000, 105, "log",    0.20, "sq",     3.20),
    "FERTILIZER": (100,10000, 200, "linear", 0.40, "linear", 0.40),
}


def _shape(name, value, scale=None):
    value = max(0.0, float(value))
    if name == "linear":
        return value
    if name == "sq":
        return value * value
    if name == "sqrt":
        return math.sqrt(value)
    if name == "log":
        return math.log1p(value)
    if name == "log10":
        return math.log10(1.0 + value)
    if name == "hinge":
        scale = max(1e-9, float(scale or 1.0))
        u = value / scale
        return u + _V2_HINGE_GAIN * max(0.0, u - 1.0) ** 2
    raise ValueError(name)


def _market_price(item, inventory):
    base, equilibrium, scale, below_func, below_target, above_func, above_target = _MARKET_PARAMS[item]
    if inventory < equilibrium:
        amplitude = below_target * base / _shape(below_func, scale, scale)
        price = base + amplitude * _shape(below_func, equilibrium - inventory, scale)
    else:
        amplitude = above_target * base / _shape(above_func, scale, scale)
        price = base - amplitude * _shape(above_func, inventory - equilibrium, scale)
    return max(_PRICE_FLOOR, int(round(price)))


def _v2_step(obs):
    explicit = _get(obs, "step")
    if explicit is not None:
        return max(0, int(explicit or 0))
    return max(0, int(_get(obs, "day", 0) or 0) * 24 + int(_get(obs, "hour", 0) or 0))


def _v2_shop_counts(obs):
    town = _get(obs, "town", {}) or {}
    return Counter(str(shop) for shop in (_get(town, "unlocked_shops", []) or []))


def _v2_new_state():
    return {
        "last_step": -1,
        "route": None,
        "shops_at_decision": (),
        "pending": {item: 0 for item in _V2_SELLABLE},
        "prices": {item: deque(maxlen=96) for item in _V2_SELLABLE},
        "carrot_substitutions": 0,
    }


_V2_STATE = {0: _v2_new_state(), 1: _v2_new_state()}


def _v2_state(obs):
    seat = _seat(obs)
    step = _v2_step(obs)
    state = _V2_STATE[seat]
    if step == 0 or step < int(state.get("last_step", -1)):
        state = _v2_new_state()
        _V2_STATE[seat] = state
    state["last_step"] = step
    prices = _get(_get(obs, "market", {}) or {}, "prices", {}) or {}
    for item in _V2_SELLABLE:
        try:
            state["prices"][item].append(max(1.0, float(_get(prices, item, 1) or 1)))
        except (TypeError, ValueError):
            pass
    return state


def _v2_route(obs, state):
    step = _v2_step(obs)
    if _V2_ROUTE_MODE == "original":
        return str(_e279_selected_expert(obs))
    if state.get("route") is None and step >= _E279_DECISION_STEP:
        counts = _v2_shop_counts(obs)
        state["shops_at_decision"] = tuple(_e279_shops(obs))
        state["route"] = "high" if counts.get("YARN_STORE", 0) >= 2 else "low"
    return str(state.get("route") or "low")


def _v2_build_suffix(actions):
    crops = tuple(_V2_CROP_DATA)
    suffix = [{crop: 0 for crop in crops} for _ in range(len(actions) + 1)]
    for step in range(len(actions) - 1, -1, -1):
        suffix[step] = dict(suffix[step + 1])
        action = actions[step]
        for unit in [action.get("farmer", ["PASS"]), *list(action.get("hands") or [])]:
            if isinstance(unit, (list, tuple)) and len(unit) >= 2 and unit[0] == "PLANT" and unit[1] in suffix[step]:
                suffix[step][unit[1]] += 1
    return suffix


_V2_SUFFIX = {name: _v2_build_suffix(actions) for name, actions in _V2_ROUTE_ACTIONS.items()}


def _v2_route_plant_count(route, crop, start, stop):
    actions = _V2_ROUTE_ACTIONS[route]
    start = min(max(0, int(start)), len(actions))
    stop = min(max(start, int(stop)), len(actions))
    return int(_V2_SUFFIX[route][start].get(crop, 0) - _V2_SUFFIX[route][stop].get(crop, 0))


def _v2_positions(farm):
    return [list(_get(farm, "farmer", [0, 0]) or [0, 0]), *[list(p) for p in (_get(farm, "hands", []) or [])]]


def _v2_inventories(obs, count):
    private = _get(obs, "private", {}) or {}
    values = [dict(inv or {}) for inv in (_get(private, "inventories", []) or [])]
    while len(values) < count:
        values.append({})
    return values[:count]


def _v2_tile(farm, position):
    try:
        x, y = int(position[0]), int(position[1])
        tiles = _get(farm, "tiles", []) or []
        if 0 <= y < len(tiles) and 0 <= x < len(tiles[y]):
            return tiles[y][x]
    except (TypeError, ValueError, IndexError):
        pass
    return None


def _v2_distance(left, right):
    return abs(int(left[0]) - int(right[0])) + abs(int(left[1]) - int(right[1]))


def _v2_nearest_shed(position, size):
    return min(sorted(_shed_access(size)), key=lambda point: (_v2_distance(position, point), point))


def _v2_move(position, target):
    x, y = int(position[0]), int(position[1])
    tx, ty = int(target[0]), int(target[1])
    if x < tx:
        return ["EAST"]
    if x > tx:
        return ["WEST"]
    if y < ty:
        return ["SOUTH"]
    if y > ty:
        return ["NORTH"]
    return ["PASS"]


def _v2_mature(tile, day):
    if not isinstance(tile, dict) or int(tile.get("yield_units", 0) or 0) <= 0:
        return False
    if tile.get("animal"):
        return True
    if tile.get("kind") != "PLANT":
        return False
    crop = str(tile.get("crop", ""))
    data = _V2_CROP_DATA.get(crop)
    return bool(data and day - int(tile.get("planted_day", day) or day) >= int(data["first"]))


def _v2_current_seed_projection(obs, action):
    private = _get(obs, "private", {}) or {}
    seeds = Counter({str(k): max(0, int(v or 0)) for k, v in dict(_get(private, "seeds", {}) or {}).items()})
