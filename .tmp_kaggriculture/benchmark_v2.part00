def download_json(url: str) -> dict:
    with urllib.request.urlopen(url, timeout=90) as response:
        return json.loads(response.read().decode("utf-8"))


def download_text(url: str) -> str:
    with urllib.request.urlopen(url, timeout=90) as response:
        return response.read().decode("utf-8")


def exact_target_payload() -> bytes:
    notebook = download_json(TARGET_NOTEBOOK_URL)
    source = next(
        "".join(cell.get("source", []))
        for cell in notebook["cells"]
        if cell.get("cell_type") == "code"
        and "AGENT_B64" in "".join(cell.get("source", []))
    )
    namespace: dict[str, object] = {}
    exec(compile(source, "target_notebook_payload.py", "exec"), namespace)
    payload = base64.b64decode(str(namespace["AGENT_B64"]))
    digest = hashlib.sha256(payload).hexdigest()
    if digest != TARGET_SHA256:
        raise RuntimeError(f"Target SHA mismatch: expected {TARGET_SHA256}, got {digest}")
    return payload


def apply_replacements(text: str, replacements: Iterable[tuple[str, str]], label: str) -> str:
    for old, new in replacements:
        count = text.count(old)
        if count != 1:
            raise RuntimeError(
                f"{label}: replacement {old!r} expected exactly once, found {count}"
            )
        text = text.replace(old, new, 1)
    return text


def build_agents(target_payload: bytes) -> dict[str, Path]:
    AGENTS.mkdir(parents=True, exist_ok=True)
    target_text = target_payload.decode("utf-8")
    overlay = "".join(part.read_text(encoding="utf-8") for part in PARTS)
    paths: dict[str, Path] = {}

    target_path = AGENTS / "target_exact.py"
    target_path.write_text(target_text + "\n# benchmark_role='target_exact'\n", encoding="utf-8")
    compile(target_path.read_text(encoding="utf-8"), str(target_path), "exec")
    paths["target_exact"] = target_path

    for variant in VARIANTS:
        text = target_text + (overlay if variant.use_overlay else "")
        text = apply_replacements(text, variant.replacements, variant.name)
        text += f"\n# benchmark_variant={variant.name!r}\n"
        path = AGENTS / f"{variant.name}.py"
        path.write_text(text, encoding="utf-8")
        compile(text, str(path), "exec")
        paths[variant.name] = path

    public_dir = AGENTS / "public"
    public_dir.mkdir(exist_ok=True)
    for name, url in PUBLIC_OPPONENTS.items():
        try:
            text = download_text(url)
            path = public_dir / f"{name}.py"
            path.write_text(text, encoding="utf-8")
            compile(text, str(path), "exec")
            paths[name] = path
        except Exception as exc:
            print(f"WARNING: public opponent {name} unavailable: {exc}", flush=True)
    return paths


