
# ============================================================================
# E300 V2 — centralized closed-loop controller for Kaggriculture 1.32.7
# ============================================================================
# The embedded low/high farm routes remain the production backbone.  This layer
# centralizes state reconciliation, market planning, resource safety, adaptive
# sales, rolling shop demand, sparse sidecars, worker recovery, and endgame.

from collections import Counter, deque

__version__ = "E300-V2-closed-loop-1.32.7"

